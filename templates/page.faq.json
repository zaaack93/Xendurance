    "6bc2d039-d8a2-40d1-90b6-75ff9d8e955b": {
      "type": "accordion-content",
      "blocks": {
        "template--16030540595388__6bc2d039-d8a2-40d1-90b6-75ff9d8e955b-168732212695a241e5-0": {
          "type": "item",
          "settings": {
            "title": "What types of supplements does Xendurance offer?",
            "content": "<p>Xendurance offers a dynamic range of sports nutrition and wellness products, formulated to boost elite athletic performance and support vibrant health for active individuals. </p><p>Backed by science and produced in GMP-certified facilities, these clean, high-potency supplements fuel peak achievement and long-term vitality for competitors and active lifestyle enthusiasts alike.*</p>"
          }
        },
        "template--16030540595388__6bc2d039-d8a2-40d1-90b6-75ff9d8e955b-168732212695a241e5-1": {
          "type": "item",
          "settings": {
            "title": "How do I determine which Xendurance product is right for me?",
            "content": "<p>We have a great 60 second quiz, \"<a href=\"https://xendurance.com/pages/perfect-path-quiz\" target=\"_blank\" title=\"https://xendurance.com/pages/perfect-path-quiz\"><strong>Find Your Fuel</strong></a>\" to help match your goals with certain products. If you have additional questions please reach out to info@xendurance.com - we love helping!</p>"
          }
        },
        "template--16030540595388__6bc2d039-d8a2-40d1-90b6-75ff9d8e955b-168732212695a241e5-2": {
          "type": "item",
          "settings": {
            "title": "Are Xendurance products safe for professional and collegiate athletes?",
            "content": "<p>Yes. Many of the Xendurance products are certified free of banned substances through the Informed Sport banned substance program. We recommend you search for your product and confirm the lot# on the Informed Sport website prior to usage.*</p>"
          }
        },
        "2c7c7830-29f7-4dec-920d-bce0eb2635e3": {
          "type": "item",
          "settings": {
            "title": "Are Xendurance products suitable for vegans or individuals with dietary restrictions?",
            "content": "<p>Yes, please review each product photo and product page to view noted allergens and review whether the product meets your needs.*</p>"
          }
        }
      },
