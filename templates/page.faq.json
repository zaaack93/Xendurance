    "7f6a1770-498a-4c6b-8afd-1369e19a6e65": {
      "type": "accordion-content",
      "blocks": {
        "84b6a815-d48d-4694-a418-c29d1cf91dc4": {
          "type": "item",
          "settings": {
            "title": "Does Xendurance ship internationally?",
            "content": "<p>Xendurance US ships internationally, excluding the EU; for EU shipping, visit <a href=\"https://xendurance.eu\" target=\"_blank\" title=\"https://xendurance.eu\">xendurance.eu</a>. If your country isn’t listed, contact info@xendurance.com for assistance.</p>"
          }
        },
        "504aca52-673a-4d50-a993-78a709a11840": {
          "type": "item",
          "settings": {
            "title": "How soon can I expect my Xendurance products to arrive after placing an order?",
            "content": "<p>Xendurance is committed to a streamlined same-day handling process when an order is received into the warehouse by 10:00 am, PST. Most shipments arrive within 1-5 business days, with 90% delivered within 3 business days within the US.*</p>"
          }
        },
        "216217a1-6988-4a4d-9601-80d0d68515bf": {
          "type": "item",
          "settings": {
            "title": "Do you offer free shipping or expedited shipping options?",
            "content": "<p>All Team XND members receive free shipping on every single order. <br/><br/>Presently, we do not offer expedited shipping options but our standard FAST shipping option usually arrives within 3 business days.</p>"
          }
        },
        "0648d0bd-3ef3-4e1b-a674-e1e5170cceba": {
          "type": "item",
          "settings": {
            "title": "Will we receive tracking for orders?",
            "content": "<p>We provide you a tracking email and link when you place an order. Please allow 24 hours before tracking information is populated.</p>"
          }
        }
      },
