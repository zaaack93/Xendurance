          "settings": {
            "title": "What ingredients are used in Xendurance supplements?",
            "content": "<p>We only use the most bioavailable, clinically researched (usually pharamaceutical grade) ingredients in all of our products.</p>"
          }
        },
        "6a89a497-9dd0-4a57-bcc2-9201bde2328a": {
          "type": "item",
          "settings": {
            "title": "Can I combine different Xendurance products together?",
            "content": "<p>Yes. Xendurance products are formulated to work synergistically together.*</p>"
          }
        }
