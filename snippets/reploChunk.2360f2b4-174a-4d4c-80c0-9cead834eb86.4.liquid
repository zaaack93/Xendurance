 15 18 9"></polyline></svg></span></div></div><div hidden=""><div data-rid="cbf22749-54a3-4bf7-857a-62ffd034ea40" data-replo-repeated-index=".0.0.0.0.0.0.0.0" class="r-110ft22"><div data-rid="aa43e053-49c6-403c-92d6-9c610e86860e" data-replo-repeated-index=".0.0.0.0.0.0.0.0.0" class="r-ydusm alchemy-rte"><span contenteditable="false" style="width:100%"><p>You do not need to take Extreme Endurance with food.</p></span></div></div></div></div><div data-rid="130d7d64-bbff-4e73-90b1-b4afd8456c4e" data-replo-repeated-index=".0.0.0.0.0.0.0" class="r-110hzcs" data-replo-collapsible="true" data-state="closed" data-orientation="vertical"><div data-rid="98b243de-f425-4e9b-8e0a-502e679267ee" aria-expanded="false" data-replo-repeated-index=".0.0.0.0.0.0.0.0" tabindex="0" role="button" class="r-190y3sy"><div data-rid="90f2e4b0-78e1-4f70-ac16-e14ea31bfaa6" data-replo-repeated-index=".0.0.0.0.0.0.0.0.0" class="r-ltwvj8 alchemy-rte"><span contenteditable="false" style="width:100%"><p>Is Extreme Endurance certified drug free?</p></span></div><div data-rid="a392e6e5-5c63-4351-93a2-8eb35a59b3ad" data-replo-repeated-index=".0.0.0.0.0.0.0.0.0" class="r-17cdum7"><span style="display:contents"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-chevron-down" style="fill: none;stroke: currentColor;width: var(--rsw, 100%);height: 100%" role="img" aria-label="Collapse/Expand"><polyline points="6 9 12 15 18 9"></polyline></svg></span></div></div><div hidden=""><div data-rid="993778be-ea6e-4252-9dc3-6aeb85d4ca58" data-replo-repeated-index=".0.0.0.0.0.0.0.0" class="r-1o0yv6d"><div data-rid="f88ee706-c5a5-479d-9d38-44da8d95d23e" data-replo-repeated-index=".0.0.0.0.0.0.0.0.0" class="r-oa5i9a alchemy-rte"><span contenteditable="false" style="width:100%"><p>Extreme Endurance was the very first US sports nutrition supplement certified drug free by LGC; Informed Sport.</p><p><br></p><p>LGC is a world-renowned sports doping control and research laboratory, with over 50 years of expertise in anti-doping in sport. LGC has published over 300 scientific papers on methods for the detection of trace levels of substances that are prohibited in sport and has over 450 man-years of research into doping control.</p><p>LGC has been testing supplements and ingredients on behalf of reputable manufacturers and suppliers for over 15&nbsp;years. It has tested tens of thousands of samples during this time and has also carried out a number of research studies to explore the prevalence of contamination with prohibited substances in products and ingredients.</p><p><br></p><p>LGC's research into supplements and contamination also includes several administration studies to investigate the levels of prohibited substances that could cause an athlete to fail a doping test. These have been published in peer-reviewed&nbsp;scientific journals. As a doping control laboratory, LGC works directly with sports authorities, national anti-doping organizations, and national governing bodies worldwide.</p></span></div></div></div></div><div data-rid="d5a95524-6e9f-432b-bd66-6b66af03ab4c" data-replo-repeated-index=".0.0.0.0.0.0.0" class="r-c6rd0c" data-replo-collapsible="true" data-state="closed" data-orientation="vertical"><div data-rid="cab09a6a-4dae-4002-a91b-ab4cb8550b73" aria-expanded="false" data-replo-repeated-index=".0.0.0.0.0.0.0.0" tabindex="0" role="button" class="r-1dw3d1k"><div data-rid="42500f14-2952-4be0-b4a2-c2a17909ae4b" data-replo-repeated-index=".0.0.0.0.0.0.0.0.0" class="r-1khalf1 alchemy-rte"><span contenteditable="false" style="width:100%"><p>Is Extreme Endurance certified drug free by the NCAA?</p></span></div><div data-rid="e4e59e8c-ca0e-46e8-8570-f4994bd6e8bc" data-replo-repeated-index=".0.0.0.0.0.0.0.0.0" class="r-1mu6lbo"><span style="display:contents"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-chevron-down" style="fill: none;stroke: currentColor;width: var(--rsw, 100%);height: 100%" role="img" aria-label="Collapse/Expand"><polyline points="6 9 12 15 18 9"></polyline></svg></span></div></div><div hidden=""><div data-rid="54d30eec-a91d-4ad2-adeb-c7d02cbe4d00" data-replo-repeated-index=".0.0.0.0.0.0.0.0" class="r-oy6gzi"><div data-rid="9bbafe38-44cb-43d9-9e2a-6884e0fd4dd8" data-replo-repeated-index=".0.0.0.0.0.0.0.0.0" class="r-mfjci9 alchemy-rte"><span contenteditable="false" style="width:100%"><p>There are no NCAA approved supplement products. The NCAA does not approve supplements.  Since 2007, Xendurance has had thousands of NCAA student-athletes take Xendurance products and rely on the Informed-Sport certification which is a global testing method for banned substances. To learn more please find the Informed-Sport&nbsp;<a target="_blank" rel="noopener nofollow noreferrer" href="https://sport.wetestyoutrust.com/"><u>link</u></a>.</p></span></div></div></div></div><div data-rid="a27f1181-209d-4efe-ad05-a6dc2e0c5379" data-replo-repeated-index=".0.0.0.0.0.0.0" class="r-11dvchb" data-replo-collapsible="true" data-state="closed" data-orientation="vertical"><div data-rid="a7dff316-cb05-49f8-a18c-eb2c06eabbe8" aria-expanded="false" data-replo-repeated-index=".0.0.0.0.0.0.0.0" tabindex="0" role="button" class="r-ei43a3"><div data-rid="7fd46a3b-296b-49c5-a211-b38b85a14a06" data-replo-repeated-index=".0.0.0.0.0.0.0.0.0" class="r-m2gsyp alchemy-rte"><span contenteditable="false" style="width:100%"><p>Can Extreme Endurance be taken with caffeine?</p></span></div><div data-rid="c80e5143-ad23-4f18-ba88-415f1ab6e3b0" data-replo-repeated-index=".0.0.0.0.0.0.0.0.0" class="r-jrbeqa"><span style="display:contents"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-chevron-down" style="fill: none;stroke: currentColor;width: var(--rsw, 100%);height: 100%" role="img" aria-label="Collapse/Expand"><polyline points="6 9 12 15 18 9"></polyline></svg></span></div></div><div hidden=""><div data-rid="84120a3f-0331-4eb7-9174-d52ac73e82fb" data-replo-repeated-index=".0.0.0.0.0.0.0.0" class="r-1ptpkhh"><div data-rid="20bd84a8-812e-4547-a122-5d461eefd116" data-replo-repeated-index=".0.0.0.0.0.0.0.0.0" class="r-1y84vqi alchemy-rte"><span contenteditable="false" style="width:100%"><p>Over the years we have found that some people have a very acidic diet and their diet may interfere with the dissolution of the product in the small intestine. On the other hand, one of our athletes drinks 12 cups of coffee per day and lives on Extreme Endurance with great results! Everyone is different but the few that have had issues cleared up the dissolution problem by limiting acidic drinks, red meat, and coffee when taking Extreme Endurance. <br><br>We now encourage people to take their caffeine within an hour prior to or after taking their tablets just as a precaution.</p></span></div></div></div></div><div data-rid="16fd66a2-b44f-40ac-bc51-7c4fb548a409" data-replo-repeated-index=".0.0.0.0.0.0.0" class="r-1se4z83" data-replo-collapsible="true" data-state="closed" data-orientation="vertical"><div data-rid="efd94346-42d2-46c5-811c-656b2f16a00b" aria-expanded="false" data-replo-repeated-index=".0.0.0.0.0.0.0.0" tabindex="0" role="button" class="r-n57ixb"><div data-rid="6edb6674-32fc-4eb7-82c6-3ab3c2fe952b" data-replo-repeated-index=".0.0.0.0.0.0.0.0.0" class="r-1ew2ium alchemy-rte"><span contenteditable="false" style="width:100%"><p>Do I need to cycle off Extreme Endurance?</p></span></div><div data-rid="40e6f7d3-c202-4202-b045-30ae577b373b" data-replo-repeated-index=".0.0.0.0.0.0.0.0.0" class="r-1kbelun"><span style="display:contents"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-chevron-down" style="fill: none;stroke: currentColor;width: var(--rsw, 100%);height: 100%" role="img" aria-label="Collapse/Expand"><polyline points="6 9 12 15 18 9"></polyline></svg></span></div></div><div hidden=""><div data-rid="4431018f-a406-42bf-b85b-f1c71566fa03" data-replo-repeated-index=".0.0.0.0.0.0.0.0" class="r-12sml1x"><div data-rid="7ee4dac2-d86b-40bb-b478-87e3f386889b" data-replo-repeated-index=".0.0.0.0.0.0.0.0.0" class="r-ddhqrc alchemy-rte"><span contenteditable="false" style="width:100%"><p>You don’t cycle with Extreme Endurance. You take it consistently, like a multivitamin; for training, performance, heart-lung function, and for better body pH and alkalinity.</p></span></div></div></div></div><div data-rid="2e323c42-7de0-469a-a391-6b572cddcf5c" data-replo-repeated-index=".0.0.0.0.0.0.0" class="r-i2zfch" data-replo-collapsible="true" data-state="closed" data-orientation="vertical"><div data-rid="223bbb3d-b7ae-47f5-ae7e-0b80142f67d3" aria-expanded="false" data-replo-repeated-index=".0.0.0.0.0.0.0.0" tabindex="0" role="button" class="r-zdiz99"><div data-rid="6526941a-dd96-42c7-9ed1-d4f3edfa447d" data-replo-repeated-index=".0.0.0.0.0.0.0.0.0" class="r-1htymnt alchemy-rte"><span contenteditable="false" style="width:100%"><p>Can an athlete take Extreme Endurance if under the age of 18?</p></span></div><div data-rid="67f696b4-49ce-40c6-b5b3-4f3e655ac669" data-replo-repeated-index=".0.0.0.0.0.0.0.0.0" class="r-19z34ci"><span style="display:contents"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-chevron-down" style="fill: none;stroke: currentColor;width: var(--rsw, 100%);height: 100%" role="img" aria-label="Collapse/Expand"><polyline points="6 9 12 15 18 9"></polyline></svg></span></div></div><div hidden=""><div data-rid="41e9e31e-b7ee-4990-9467-9ef94cb5ac53" data-replo-repeated-index=".0.0.0.0.0.0.0.0" class="r-wqmfxj"><div data-rid="4c8f361f-a742-4bcc-bc91-f4cc334040ba" data-replo-repeated-index=".0.0.0.0.0.0.0.0.0" class="r-sp4c7u alchemy-rte"><span contenteditable="false" style="width:100%"><p>We encourage a parent to email <a href="mailto:info@xendurance.com">info@xendurance.com</a> and provide the sport and activity level of their child and their age, and weight. We can then provide better guidance for the parent as to the experience we have seen with athletes using the product under the age of 18. We do not recommend anyone under the age of 14 use Extreme Endurance.</p></span></div></div></div></div><div data-rid="0778000f-2b19-4803-a3e9-40650a09c813" data-replo-repeated-index=".0.0.0.0.0.0.0" class="r-1002w1n" data-replo-collapsible="true" data-state="closed" data-orientation="vertical"><div data-rid="42e7620d-f885-41b4-8faf-08a0a5d4cc8b" aria-expanded="false" data-replo-repeated-index=".0.0.0.0.0.0.0.0" tabindex="0" role="button" class="r-1utdr5i"><div data-rid="b1a3ca6a-1463-428e-aec5-daac6520e44b" data-replo-repeated-index=".0.0.0.0.0.0.0.0.0" class="r-1ov6ifs alchemy-rte"><span contenteditable="false" style="width:100%"><p>When should you take Extreme Endurance? What time of day?</p></span></div><div data-rid="d062729c-3173-44c0-ac2a-29c9ebbaef3b" data-replo-repeated-index=".0.0.0.0.0.0.0.0.0" class="r-1bgt34j"><span style="display:contents"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-chevron-down" style="fill: none;stroke: currentColor;width: var(--rsw, 100%);height: 100%" role="img" aria-label="Collapse/Expand"><polyline points="6 9 12 15 18 9"></polyline></svg></span></div></div><div hidden=""><div data-rid="2e5cbaad-06c9-48a0-a06a-2ea18d079c8c" data-replo-repeated-index=".0.0.0.0.0.0.0.0" class="r-12ynr53"><div data-rid="f97d69ef-10ce-478c-82d2-5d2312165ca7" data-replo-repeated-index=".0.0.0.0.0.0.0.0.0" class="r-1368v8w alchemy-rte"><span contenteditable="false" style="width:100%"><p>The most important thing to remember when taking Extreme Endurance is to take it consistently like you would a multivitamin. You can split the morning and evening dosage to the time of the day that works best for you. Ex; If you take it at 6 am and 5 pm, we encourage you to try to take it around 6 am and 5 pm everyday. You can take it with or without food.</p></span></div></div></div></div><div data-rid="50b7635b-73fc-4289-84f1-f1a91f8cf6f0" data-replo-repeated-index=".0.0.0.0.0.0.0" class="r-lvnscs" data-replo-collapsible="true" data-state="closed" data-orientation="vertical"><div data-rid="fae6ae67-d332-4e7e-aa46-ee0951cb0255" aria-expanded="false" data-replo-repeated-index=".0.0.0.0.0.0.0.0" tabindex="0" role="button" class="r-fw0cmc"><div data-rid="01f1cdb0-c6ed-4a29-8b4a-9e04186b3b3f" data-replo-repeated-index=".0.0.0.0.0.0.0.0.0" class="r-14smban alchemy-rte"><span contenteditable="false" style="width:100%"><p>What is a “Load Dose”?</p></span></div><div data-rid="0d8c2a45-e0c6-4b5f-a8ca-8a7dec399204" data-replo-repeated-index=".0.0.0.0.0.0.0.0.0" class="r-1nx3d5z"><span style="display:contents"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-chevron-down" style="fill: none;stroke: currentColor;width: var(--rsw, 100%);height: 100%" role="img" aria-label="Collapse/Expand"><polyline points="6 9 12 15 18 9"></polyline></svg></span></div></div><div hidden=""><div data-rid="5246cb94-bce4-4d93-bbfb-3eb86ce9cca9" data-replo-repeated-index=".0.0.0.0.0.0.0.0" class="r-1p5i6q0"><div data-rid="883ed381-348c-45c0-9f7a-5faf4e58d514" data-replo-repeated-index=".0.0.0.0.0.0.0.0.0" class="r-1fq0bc7 alchemy-rte"><span contenteditable="false" style="width:100%"><p>The normal dose of Extreme Endurance is 6 tablets per day: 3 in the morning and 3 in the evening. For athletes that will be having a significant event or an “extreme” event such as an ultra-distance race, a state meet, or an event that is more intense than your normal events, we recommend what is called a “load dose”. A load dose is taken 7-10 days out from the event and you increase the dosage to 8 tablets per day: 4 in the morning and 4 in the evening and you take 8 tablets for one day after the event and then drop back down to the normal dose of 6 tablets per day. In 2008, our pro-triathletes started using a load dose and they informed us they had their best results bumping up their dosage, so this is why we tell competitors in every sport to use the load dose.</p></span></div></div></div></div><div data-rid="3038c9c7-c1a7-4a85-a440-2b096595c19d" data-replo-repeated-index=".0.0.0.0.0.0.0" class="r-iaa6na" data-replo-collapsible="true" data-state="closed" data-orientation="vertical"><div data-rid="dbd1a94e-d670-4b1a-b3a8-e25f6c362aea" aria-expanded="false" data-replo-repeated-index=".0.0.0.0.0.0.0.0" tabindex="0" role="button" class="r-1ikl2ze"><div data-rid="041a17d5-ddeb-4a00-abc6-922cea10a2c8" data-replo-repeated-index=".0.0.0.0.0.0.0.0.0" class="r-j7lw06 alchemy-rte"><span contenteditable="false" style="width:100%"><p>What sports will benefit from using Extreme Endurance?</p></span></div><div data-rid="c6884eea-f759-4dba-9254-16de7b12e761" data-replo-repeated-index=".0.0.0.0.0.0.0.0.0" class="r-11t2z5u"><span style="display:contents"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-chevron-down" style="fill: none;stroke: currentColor;width: var(--rsw, 100%);height: 100%" role="img" aria-label="Collapse/Expand"><polyline points=