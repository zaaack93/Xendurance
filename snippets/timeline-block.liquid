
<div class="timeline-container">
  {%- if block.settings.heading_1 != blank or block.settings.content_1 != blank -%}
    <div class="timeline-item">
        {%- if block.settings.image_1 != blank -%}
            {%- capture sizes -%}(max-width: 699px) calc(73vw - 40px), (max-width: 999px) calc(38vw - 64px), calc(min({{ settings.page_width }}px, 100vw) / {{ block.settings.column_size }}){%- endcapture -%}
            {{- block.settings.image_1 | image_url: width: block.settings.image_1.width | image_tag: loading: 'lazy', sizes: sizes, widths: '300,400,500,600,800,1000,1200,1400,1600,1800', class: 'rounded' -}}
          {%- endif -%}
        
     <div class="timeline-item-container">
      {%- if block.settings.heading_1 != blank -%}
        <p class="heading">{{ block.settings.heading_1 | escape }}</p>
      {%- endif -%}

      {%- if block.settings.content_1 != blank -%}
        <div class="prose content">
          {{- block.settings.content_1 -}}
        </div>
      {%- endif -%}
    </div> 

    </div>
  {%- endif -%}



  {%- if block.settings.heading_2 != blank or block.settings.content_2 != blank -%}
